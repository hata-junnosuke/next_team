# web/.env.local にコピーして使う（docs/01_技術仕様_next.md の環境変数）
# サーバ側（Server Component / Server Action / Route Handler）が叩く API
API_URL=http://localhost:8002
# ブラウザ側（ログイン・ログアウトだけ）が叩く API
NEXT_PUBLIC_API_URL=http://localhost:8002
# サーバ側 fetch に付ける Origin / Referer（Sanctum の stateful 判定に必要）
WEB_ORIGIN=http://localhost:3002
