APP_NAME=next_team
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# P4: キューは Redis（Horizon が処理する）。テストは phpunit.xml の sync
QUEUE_CONNECTION=redis

# P4: キャッシュとロックは Redis。テストは phpunit.xml の array
CACHE_STORE=redis
# 他の弾（第1弾・第2弾）と同じ Redis を共有してもキーが衝突しないよう、接頭辞をこのプロジェクト固有にする
CACHE_PREFIX=next-team-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# 他の弾と同じ Redis を共有してもキュー・Horizon のキーが衝突しないよう、接頭辞をこのプロジェクト固有にする
REDIS_PREFIX=next-team-database-
HORIZON_PREFIX=next-team-horizon:

# P4: Telescope（開発用。ローカル環境だけ登録する。画面は http://localhost:8002/telescope）。テストは phpunit.xml で false
TELESCOPE_ENABLED=true

# P4: Mailpit（make up。受信箱は http://localhost:8025）。テストは phpunit.xml の array
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@myteam.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- next_team（docs/01_技術仕様_next.md 2 章） ---
APP_TIMEZONE=Asia/Tokyo
FRONTEND_URL=http://localhost:3002
SANCTUM_STATEFUL_DOMAINS=localhost:3002
MYTEAM_MIN_WAGE=1226

# --- P4（非同期。docs/01 2 章）---
# F-22 前日リマインドの送信時刻（config/myteam.php の reminder_time。P4-04 で使う）
MYTEAM_REMINDER_TIME=18:00
# F-21 メール送信の 1 分あたりの上限（config/myteam.php の mails_per_minute。RateLimiter::for('mails')）
MYTEAM_MAILS_PER_MINUTE=60
# F-20〜F-22 メールのジョブの再試行をあきらめるまでの分数（config/myteam.php の mail_retry_until_minutes。ジョブの retryUntil()）
MYTEAM_MAIL_RETRY_UNTIL_MINUTES=60
# F-23: 集計出力が生成中のまま止まったとみなす分数（同じ月の新しい依頼で failed にする）
MYTEAM_REPORT_EXPORT_STALE_MINUTES=30
# F-19: ダッシュボードのキャッシュの秒数（config/myteam.php の dashboard_cache_seconds。翌日 0:00 は超えない。0 以下でキャッシュしない）
MYTEAM_DASHBOARD_CACHE_SECONDS=300
